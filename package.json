{
  "name": "lizlenjo-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/optimise-lookbook.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy --keep-vars && wrangler d1 migrations apply DB --remote",
    "notions:fetch": "node scripts/fetch-notions.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/preact": "^4.1.3",
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "astro": "^5.18.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.56.1",
    "fast-xml-parser": "^4.5.7",
    "node-html-parser": "^6.1.13",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.148.0"
  }
}
