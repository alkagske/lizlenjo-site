---
import Base from '../../layouts/Base.astro';
import Notion from '../../components/Notion.astro';
// The Workroom's front door, and the only Workroom page outside Cloudflare Access (which protects
// workroom/* and api/admin*). Its button opens /workroom/posts, which Access sends straight to Google.
---
<Base title="Sign in" noindex tape="none">
  <main id="main" tabindex="-1" class="wrap signin">
    <a href="/" class="signin-logo"><img src="/logo-9.webp" alt="Liz Lenjo" width="101" height="92"></a>
    <div class="eyebrow"><Notion name="scissors" height={40} rotate={-12} /><div class="label">The Workroom</div></div>
    <h1 class="h1">Welcome back, <span class="underline-chalk">Liz.</span></h1>
    <p class="lede">Write, schedule and publish Liz Notes, answer comments and read enquiries.</p>
    <a class="btn btn-ink signin-btn" href="/workroom/posts">Continue with Google →</a>
    <p class="label-muted">Only invited accounts can open the Workroom.</p>
    <a href="/" class="signin-back">← Back to lizlenjo.com</a>
  </main>
</Base>

<style>
  .signin { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 20px; max-width: 560px; padding-top: 48px; padding-bottom: 48px; }
  .signin-logo img { height: 72px; width: auto; display: block; }
  .signin .lede { max-width: 440px; }
  .signin-btn { padding: 14px 22px; margin-top: 6px; }
  .signin-back { font-size: 14px; color: var(--muted); margin-top: 12px; }
  .signin-back:hover { color: var(--ink); }
</style>
