---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Notion from '../components/Notion.astro';
import { listPhotos, type PhotoRow } from '../lib/db';
import { mediaUrl, srcset, transformsOn } from '../lib/media';
import { LOOKBOOK_COLLECTIONS, SITE } from '../content/site';
import { breadcrumbLd } from '../lib/seo';
export const prerender = false;

const env = Astro.locals.runtime.env;
let photos: PhotoRow[] = [];
try {
  photos = await listPhotos(env.DB);
} catch (e) {
  console.error('lookbook: D1 unavailable', e);
}
const tf = transformsOn(env);
const counts = Object.fromEntries(LOOKBOOK_COLLECTIONS.map((c) => [c, photos.filter((p) => p.collection === c).length]));
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');
// Display shapes for the Pinterest-style wall ('auto' keeps the photo's own ratio).
const SHAPE_RATIO: Record<string, string> = { tall: '2 / 3', portrait: '3 / 4', square: '1 / 1', wide: '16 / 9' };
---
<Base title="Lookbook" description="Photographs of Liz Lenjo: the advocate, the lecturer, fashion and editorial portraits." jsonLd={breadcrumbLd([{ name: 'Home', url: SITE.url }, { name: 'Lookbook', url: `${SITE.url}/lookbook` }])}>
  <SiteHeader />
  <main id="main" tabindex="-1" class="wrap lookbook">
    <header class="two-col" style="align-items:end">
      <div style="display:flex;flex-direction:column;gap:18px">
        <div class="eyebrow"><Notion name="safety-pins" height={50} rotate={-8} /><div class="label">The lookbook</div></div>
        <h1 class="h1">Four collections, <span class="underline-chalk">one wardrobe.</span></h1>
      </div>
      <div style="display:flex;flex-direction:column;gap:16px">
        <p class="lede">The advocate, the lecturer, the runway and the portrait. Select a photograph to see it full screen; use the arrow keys or swipe to move through the collection.</p>
        <div class="filters" role="group" aria-label="Collections">
          <button type="button" class="chip" aria-pressed="true" data-filter="all">All <span class="n">{photos.length}</span></button>
          {LOOKBOOK_COLLECTIONS.map((c) => counts[c] ? <button type="button" class="chip" aria-pressed="false" data-filter={c}>{c} <span class="n">{counts[c]}</span></button> : null)}
        </div>
      </div>
    </header>

    {photos.length === 0 ? (
      <p class="empty">The lookbook is being pressed. Check back soon.</p>
    ) : (
      <div class="pins" role="list" data-gallery>
        {photos.map((p, i) => {
          const set = srcset(p.r2_key, tf);
          const ratio = SHAPE_RATIO[p.shape] ?? (p.width && p.height ? `${p.width} / ${p.height}` : '4 / 5');
          return (
            <div class="pin" role="listitem" data-collection={p.collection}>
              <button type="button" class="pin-btn" data-index={i} data-full={mediaUrl(p.r2_key, 1600, tf)} data-caption={p.caption} data-collection-label={p.collection} aria-label={`Open photo: ${p.caption || p.alt}`} style={`aspect-ratio:${ratio}`}>
                <img src={mediaUrl(p.r2_key, 960, tf)} srcset={set || undefined} sizes="(min-width: 1200px) 260px, (min-width: 700px) 33vw, 50vw" alt={p.alt || p.caption} width={p.width || undefined} height={p.height || undefined} loading={i < 6 ? 'eager' : 'lazy'} decoding="async" style={`object-position:${p.object_position}`}>
                <span class="pin-shade" aria-hidden="true"><span class="mono">{p.collection}</span>{p.caption && <span class="serif">{p.caption}</span>}</span>
              </button>
              {p.caption && <div class="pin-cap">{p.caption}</div>}
            </div>
          );
        })}
      </div>
    )}
  </main>

  <dialog class="lightbox" data-lightbox aria-label="Photo viewer">
    <div class="lb-top"><span class="mono" data-lb-count></span><button type="button" class="btn btn-square lb-close" data-lb-close aria-label="Close">×</button></div>
    <figure class="lb-fig">
      <img data-lb-img alt="">
      <figcaption><span class="mono" data-lb-coll></span> <span class="serif" data-lb-cap></span></figcaption>
    </figure>
    <button type="button" class="btn btn-square lb-prev" data-lb-prev aria-label="Previous photo">←</button>
    <button type="button" class="btn btn-square lb-next" data-lb-next aria-label="Next photo">→</button>
  </dialog>
  <SiteFooter />
</Base>

<style>
  .lookbook { padding-top: clamp(56px, 8vw, 110px); padding-bottom: var(--section-y); display: flex; flex-direction: column; gap: 56px; }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; }
  .filters .chip { border-radius: 999px; padding: 9px 16px; }
  .filters .n { opacity: .55; margin-left: 4px; }
  .empty { font-family: var(--serif); font-style: italic; font-size: 24px; color: var(--text-3); }
  /* Pinterest-style wall: narrow columns, tight gutters, natural or chosen shapes. */
  .pins { list-style: none; margin: 0; padding: 0; columns: 5 220px; column-gap: 16px; }
  .pin { break-inside: avoid; margin: 0 0 18px; display: flex; flex-direction: column; gap: 8px; }
  .pin[hidden] { display: none; }
  .pin-btn { all: unset; box-sizing: border-box; cursor: zoom-in; display: block; position: relative; width: 100%; overflow: hidden; border-radius: 16px; background: #e9e6ef; isolation: isolate; }
  .pin-btn img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--lift); }
  .pin-shade { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; gap: 4px; padding: 16px; color: #fff; background: linear-gradient(to top, rgba(20, 33, 61, .78), rgba(20, 33, 61, 0) 55%); opacity: 0; transition: opacity .35s ease; }
  .pin-shade .mono { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--on-dark-4); }
  .pin-shade .serif { font-size: 20px; line-height: 1.15; }
  .pin-btn:hover img, .pin-btn:focus-visible img { transform: scale(1.04); }
  .pin-btn:hover .pin-shade, .pin-btn:focus-visible .pin-shade { opacity: 1; }
  .pin-btn:focus-visible { outline: 2px solid var(--cobalt); outline-offset: 3px; }
  .pin-cap { font-size: 13px; line-height: 1.35; color: var(--text-2); padding: 0 4px; }
  /* Touch screens have no hover: keep the caption under the photo only. */
  @media (hover: hover) { .pin-cap { display: none; } }
  /* With JavaScript, pins are placed in the shortest column (left to right, like Pinterest). */
  .pins.js { columns: auto; display: flex; gap: 16px; align-items: flex-start; }
  .pins.js > :global(.pin-col) { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; }
  @media (max-width: 700px) { .pins { columns: 2; column-gap: 10px; } .pins.js { gap: 10px; } .pin { margin-bottom: 12px; } .pin-btn { border-radius: 12px; } }
  .lightbox { width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(20, 33, 61, .96); color: var(--paper); }
  .lightbox::backdrop { background: rgba(20, 33, 61, .9); }
  .lightbox[open] { display: grid; grid-template-rows: auto 1fr; }
  .lb-top { display: flex; justify-content: space-between; align-items: center; padding: 16px var(--pad-x); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--on-dark-2); }
  .lb-fig { margin: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 0 clamp(56px, 8vw, 110px) 28px; min-height: 0; }
  .lb-fig img { max-width: 100%; max-height: calc(100vh - 150px); object-fit: contain; box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .6); }
  .lb-fig figcaption { text-align: center; }
  .lb-fig .mono { font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--on-dark-4); margin-right: 8px; }
  .lb-fig .serif { font-size: 22px; }
  .lightbox .btn { border-color: var(--paper); color: var(--paper); }
  .lightbox .btn:hover { background: var(--paper); color: var(--ink); }
  .lb-prev, .lb-next { position: fixed; top: 50%; transform: translateY(-50%); }
  .lb-prev { left: clamp(10px, 2vw, 28px); }
  .lb-next { right: clamp(10px, 2vw, 28px); }
  @media (max-width: 600px) { .lb-fig { padding: 0 12px 70px; } .lb-prev, .lb-next { top: auto; bottom: 16px; transform: none; } }
</style>
<script>
  import '../scripts/site';
  const gallery = document.querySelector('[data-gallery]');
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (gallery && dlg) {
    const tiles = [...gallery.querySelectorAll<HTMLElement>('.pin')];
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dlg.querySelector('[data-lb-cap]')!;
    const coll = dlg.querySelector('[data-lb-coll]')!;
    const count = dlg.querySelector('[data-lb-count]')!;
    // Shortest-column placement. Heights come from each pin's aspect ratio, so no image needs to load first.
    const ratioOf = (t: HTMLElement) => {
      const btn = t.querySelector<HTMLElement>('.pin-btn')!;
      const [w, h] = (btn.style.aspectRatio || '4 / 5').split('/').map(Number);
      return h! / w! + (t.querySelector('.pin-cap') && !matchMedia('(hover: hover)').matches ? 0.12 : 0);
    };
    let lastCols = 0;
    const layout = () => {
      const width = gallery.clientWidth || innerWidth;
      const visibleTiles = tiles.filter((t) => !t.hidden);
      const byWidth = width >= 1200 ? 5 : width >= 900 ? 4 : width >= 640 ? 3 : 2;
      const cols = Math.max(2, Math.min(byWidth, Math.ceil(visibleTiles.length / 2)));
      const columns = Array.from({ length: cols }, () => { const c = document.createElement('div'); c.className = 'pin-col'; return c; });
      const heights = new Array(cols).fill(0);
      for (const t of visibleTiles) {
        const k = heights.indexOf(Math.min(...heights));
        columns[k]!.appendChild(t);
        heights[k] += ratioOf(t) + 0.08;
      }
      tiles.filter((t) => t.hidden).forEach((t) => columns[0]!.appendChild(t));
      gallery.replaceChildren(...columns);
      gallery.classList.add('js');
      lastCols = cols;
    };
    layout();
    let rt = 0;
    addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => { const w = gallery.clientWidth; const want = w >= 1200 ? 5 : w >= 900 ? 4 : w >= 640 ? 3 : 2; if (want !== lastCols) layout(); }, 150); });
    let list: HTMLButtonElement[] = [];
    let at = 0;
    let opener: HTMLElement | null = null;
    const visible = () => tiles.filter((t) => !t.hidden).map((t) => t.querySelector<HTMLButtonElement>('.pin-btn')!);
    const show = (k: number) => {
      at = (k + list.length) % list.length;
      const b = list[at]!;
      const thumb = b.querySelector('img')!;
      img.src = b.dataset.full!;
      img.alt = thumb.alt;
      cap.textContent = b.dataset.caption ?? '';
      coll.textContent = b.dataset.collectionLabel ?? '';
      count.textContent = `${String(at + 1).padStart(2, '0')} / ${String(list.length).padStart(2, '0')}`;
      // Preload neighbours for instant paging.
      [at + 1, at - 1].forEach((j) => { const n = list[(j + list.length) % list.length]; if (n) new Image().src = n.dataset.full!; });
    };
    gallery.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.pin-btn');
      if (!b) return;
      list = visible();
      opener = b;
      show(list.indexOf(b));
      dlg.showModal();
    });
    dlg.querySelector('[data-lb-close]')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(at - 1));
    dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(at + 1));
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(at + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(at - 1); }
    });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => opener?.focus());
    let tx = 0;
    dlg.addEventListener('touchstart', (e) => { tx = e.touches[0]!.clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => { const dx = e.changedTouches[0]!.clientX - tx; if (Math.abs(dx) > 40) show(at + (dx < 0 ? 1 : -1)); });

    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b, _, all) =>
      b.addEventListener('click', () => {
        all.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        const f = b.dataset.filter;
        tiles.forEach((t) => (t.hidden = f !== 'all' && t.dataset.collection !== f));
        layout();
      }),
    );
  }
</script>
